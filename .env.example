# Get a key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional: pin a tested model version instead of following jev-latest.
TYPESAFE_MODEL=jev-latest

# Self-hosted Laya server. Start laya-serve separately, then set its local URL here.
LAYA_BASE_URL=http://127.0.0.1:8000
LAYA_MODEL=typed-decisions

# Optional: use the same value configured as LAYA_API_KEY on the Laya server.
LAYA_API_KEY=
